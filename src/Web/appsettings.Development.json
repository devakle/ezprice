{
  "ConnectionStrings": {
    "EZPriceDb": "Data Source=ezprice.dev.db"
  },
  "DatabaseProvider": "Sqlite",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore.SpaProxy": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "User": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "IndexName": "ezprice-offers"
  },
  "Search": {
    "CacheTtlSeconds": 300,
    "PageSize": 24,
    "Sources": [ "ml", "amazon" ]
  },
  "Scraping": {
    "Enabled": true,
    "Headless": true,
    "TimeoutMs": 120000,
    "WaitForSelectorMs": 30000,
    "ScrollWaitMs": 200,
    "ScrollCount": 10,
    "SlowMoMs": 0,
    "UserAgent": "EZPrice/1.0",
    "BrowserPath": "",
    "DownloadPath": "",
    "UseCdpIfAvailable": true
  }
}
